{
  "info": {
    "name": "Restaurant Ordering System API",
    "description": "Collection usada para testar as rotas desenvolvidas até a aula de 27/08.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "GET - List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/categories"
          }
        },
        {
          "name": "POST - Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lanches\",\n  \"description\": \"Lanches do cardápio\",\n  \"icon\": \"🍔\",\n  \"display_order\": 4\n}"
            },
            "url": "{{base_url}}/categories"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET - List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "POST - Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"11111111-1111-4111-8111-111111111111\",\n  \"title\": \"Pizza Margherita\",\n  \"description\": \"Mussarela, tomate e manjericão\",\n  \"price\": 45.90,\n  \"image\": null,\n  \"available\": true\n}"
            },
            "url": "{{base_url}}/products"
          }
        }
      ]
    }
  ]
}
