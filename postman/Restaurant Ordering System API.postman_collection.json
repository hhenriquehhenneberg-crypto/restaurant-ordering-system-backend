{
  "info": {
    "name": "Restaurant Ordering System API - CRUD completo",
    "description": "Catálogo MVC: categorias e produtos, incluindo validação, busca e administração.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "admin_key",
      "value": "SUBSTITUA_PELA_SUA_CHAVE_PRIVADA"
    },
    {
      "key": "category_id",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "product_id",
      "value": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
    }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "GET - Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/categories"
          }
        },
        {
          "name": "GET - Pesquisar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/categories/search?keyword=Pizzas"
          }
        },
        {
          "name": "GET - Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/categories/{{category_id}}"
          }
        },
        {
          "name": "POST - Cadastrar categoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{admin_key}}"
              }
            ],
            "url": "{{base_url}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pizzas Teste\",\n  \"description\": \"Categoria criada na API\",\n  \"icon\": \"🍕\",\n  \"display_order\": 5,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"category_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Atualizar categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{admin_key}}"
              }
            ],
            "url": "{{base_url}}/categories/{{category_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Atualizada via Postman\",\n  \"display_order\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE - Remover categoria",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{admin_key}}"
              }
            ],
            "url": "{{base_url}}/categories/{{category_id}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET - Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "GET - Filtrar por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products?category_id={{category_id}}"
          }
        },
        {
          "name": "GET - Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products/{{product_id}}"
          }
        },
        {
          "name": "POST - Cadastrar produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{admin_key}}"
              }
            ],
            "url": "{{base_url}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{category_id}}\",\n  \"title\": \"Pizza Margherita\",\n  \"description\": \"Queijo, molho e manjericão\",\n  \"price\": 39.9,\n  \"available\": true,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"product_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Atualizar produto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{admin_key}}"
              }
            ],
            "url": "{{base_url}}/products/{{product_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 44.9,\n  \"available\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE - Remover produto",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{admin_key}}"
              }
            ],
            "url": "{{base_url}}/products/{{product_id}}"
          }
        }
      ]
    },
    {
      "name": "GET - Informações da API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      }
    }
  ]
}
