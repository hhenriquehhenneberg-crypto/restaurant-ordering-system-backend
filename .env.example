# Copie este arquivo para .env e substitua os valores de exemplo.
PORT=3000
# Em Supabase, use a URI PostgreSQL do pooler com SSL (não uma chave de API).
DATABASE_URL=postgresql://postgres:senha@localhost:5432/restaurant_ordering
# Chave privada longa e aleatória. Não envie para o Git.
ADMIN_API_KEY=substituir-por-chave-aleatoria-com-32-ou-mais-caracteres
